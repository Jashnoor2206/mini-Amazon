<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Password</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/forgotPassword.css">
  <link rel="stylesheet" href="/css/resetPassword.css">
</head>
<body class="fp-body">
  <section class="fp-shell">
    <!-- Left: form -->
    <div class="fp-panel">
      <div class="fp-inner">
        <a href="/amazon-clone/login" class="fp-back">&larr; Back to log in</a>

        <h1 class="fp-heading">Set a new password</h1>
        <p class="fp-sub">
          Your code is verified. Choose a new password with at least 6 characters.
        </p>

        <% if (typeof error !== 'undefined' && error) { %>
          <p class="fp-alert fp-alert-error"><%= error %></p>
        <% } %>

        <form action="/user/reset-password" method="POST" class="fp-form rp-form" id="resetForm">
          <div class="fp-field">
            <label for="password" class="fp-label">New password</label>
            <div class="fp-input-wrap rp-input-wrap">
              <input
                id="password"
                name="password"
                type="password"
                minlength="6"
                required
                autofocus
                autocomplete="new-password"
                placeholder="Create a new password"
                class="fp-input"
              >
              <button type="button" class="rp-toggle" data-target="password" aria-label="Show password">Show</button>
            </div>
          </div>

          <div class="fp-field">
            <label for="confirmPassword" class="fp-label">Confirm password</label>
            <div class="fp-input-wrap rp-input-wrap">
              <input
                id="confirmPassword"
                name="confirmPassword"
                type="password"
                minlength="6"
                required
                autocomplete="new-password"
                placeholder="Type it again"
                class="fp-input"
              >
              <button type="button" class="rp-toggle" data-target="confirmPassword" aria-label="Show password">Show</button>
            </div>
            <p class="rp-hint" id="matchHint" aria-live="polite"></p>
          </div>

          <button type="submit" class="fp-button">Update password</button>
        </form>
      </div>
    </div>

    <!-- Right: quote panel -->
    <div class="fp-art">
      <p class="fp-quote">&ldquo;Fresh start. Pick something you'll remember this time.&rdquo;</p>
    </div>
  </section>

  <script src="/js/resetPassword.js" defer></script>
</body>
</html>
