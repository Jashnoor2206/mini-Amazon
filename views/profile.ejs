<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your Profile - Node</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Pacifico&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/profile.css">
</head>
<body>

  <!-- Reuse your topbar include if you have one, else keep this minimal -->
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/amazon-clone" class="logo">Node</a>
    </div>
  </header>

  <div class="profile-page">

    <!-- Left: Info card -->
    <div class="profile-card">
      <div class="profile-avatar">
        <%= user.name ? user.name.charAt(0).toUpperCase() : "U" %>
      </div>

      <h2 class="profile-name"><%= user.name %></h2>
      <p class="profile-email"><%= user.email %></p>

      <div class="profile-details">
        <div class="detail-row">
          <span class="detail-label">Full Name</span>
          <span class="detail-value"><%= user.name %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Email</span>
          <span class="detail-value"><%= user.email %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Contact</span>
          <span class="detail-value"><%= user.contact || "Not added" %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Default Address</span>
          <span class="detail-value">
            <% if (user.addresses && user.addresses.length) { %>
              <%= user.addresses[0].street %>, <%= user.addresses[0].city %>, <%= user.addresses[0].state %> - <%= user.addresses[0].postalCode %>
            <% } else { %>
              No address added
            <% } %>
          </span>
        </div>
      </div>

      <a href="/profile/edit" class="edit-btn">Edit Profile</a>
    </div>

    <!-- Right: Quick actions -->
    <div class="profile-actions">
      <a href="/orders" class="action-item">
        <span class="action-icon"></span>
        <div class="action-text">
          <span class="action-title">Your Orders</span>
          <span class="action-sub">Track, return, or buy again</span>
        </div>
        <span class="action-arrow">›</span>
      </a>

      <a href="/cart" class="action-item">
        <span class="action-icon"></span>
        <div class="action-text">
          <span class="action-title">Cart</span>
          <span class="action-sub">View items added to cart</span>
        </div>
        <span class="action-arrow">›</span>
      </a>

      <a href="/wishlist" class="action-item">
        <span class="action-icon"></span>
        <div class="action-text">
          <span class="action-title">Wishlist</span>
          <span class="action-sub">Items you've saved</span>
        </div>
        <span class="action-arrow">›</span>
      </a>

      <a href="/address" class="action-item">
        <span class="action-icon"></span>
        <div class="action-text">
          <span class="action-title">Manage Addresses</span>
          <span class="action-sub">Add or edit delivery addresses</span>
        </div>
        <span class="action-arrow">›</span>
      </a>

      <% if (user.role === "seller") { %>
      <a href="/seller/dashboard" class="action-item">
        <span class="action-icon"></span>
        <div class="action-text">
          <span class="action-title">Seller Dashboard</span>
          <span class="action-sub">Manage your listings</span>
        </div>
        <span class="action-arrow">›</span>
      </a>
      <% } %>

      <a href="/auth/switch-account" class="action-item">
        <span class="action-icon"></span>
        <div class="action-text">
          <span class="action-title">Switch Account</span>
          <span class="action-sub">Sign in with a different account</span>
        </div>
        <span class="action-arrow">›</span>
      </a>

      <form action="/auth/logout" method="POST" class="logout-form">
        <button type="submit" class="action-item logout-item">
          <span class="action-icon"></span>
          <div class="action-text">
            <span class="action-title">Logout</span>
            <span class="action-sub">Sign out of this device</span>
          </div>
          <span class="action-arrow">›</span>
        </button>
      </form>
    </div>

  </div>

</body>
</html>