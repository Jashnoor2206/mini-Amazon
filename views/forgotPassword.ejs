<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Forgot Password</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/forgotPassword.css">
</head>
<body class="fp-body">
  <section class="fp-shell">
    <!-- Left: form -->
    <div class="fp-panel">
      <div class="fp-inner">
        <a href="/amazon-clone/login" class="fp-back">&larr; Back to log in</a>

        <h1 class="fp-heading">Forgot password?</h1>
        <p class="fp-sub">
          Enter the email you registered with. We'll send you a 6-digit code to reset your password.
        </p>

        <% if (typeof error !== 'undefined' && error) { %>
          <p class="fp-alert fp-alert-error"><%= error %></p>
        <% } %>
        <% if (typeof message !== 'undefined' && message) { %>
          <p class="fp-alert fp-alert-success"><%= message %></p>
        <% } %>

        <form action="/user/forgot-password" method="POST" class="fp-form">
          <div class="fp-field">
            <label for="email" class="fp-label">Email</label>
            <div class="fp-input-wrap">
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="email@example.com"
                value="<%= typeof email !== 'undefined' ? email : '' %>"
                class="fp-input"
              >
            </div>
          </div>

          <button type="submit" class="fp-button">Send code</button>

          <p class="fp-footer">
            Remembered it? <a href="/amazon-clone/login">Log in</a>
          </p>
        </form>
      </div>
    </div>

    <!-- Right: quote panel -->
    <div class="fp-art">
      <p class="fp-quote">&ldquo;Locked out? It happens. We'll get you back to your cart in a minute.&rdquo;</p>
    </div>
  </section>
</body>
</html>
