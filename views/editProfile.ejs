<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Profile - Node</title>
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Pacifico&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/editProfile.css">
  <link rel="stylesheet" href="/css/toast.css">
</head>
<body>

  <header class="topbar">
    <div class="topbar-inner">
      <a href="/amazon-clone" class="logo">Node</a>
    </div>
  </header>

  <main class="edit-page">
    <div class="page-head">
      <h1>Edit profile</h1>
      <a href="/amazon-clone/profile" class="back-link">← Back to profile</a>
    </div>

    <div class="edit-grid">

      <!-- Left: profile photo -->
      <section class="edit-card photo-card">
        <div class="photo-preview" id="photo-preview">
          <% if (user.profilePhoto) { %>
            <img src="<%= user.profilePhoto %>" alt="Profile photo" id="photo-img">
          <% } else { %>
            <span class="photo-initial" id="photo-initial"><%= user.name ? user.name.charAt(0).toUpperCase() : "U" %></span>
            <img src="" alt="Profile photo" id="photo-img" hidden>
          <% } %>
        </div>

        <h2 class="photo-name"><%= user.name %></h2>
        <p class="photo-email"><%= user.email %></p>

        <!-- the file input belongs to the details form below via form="profile-form" -->
        <label for="profilePhoto" class="photo-btn">Change photo</label>
        <input type="file" id="profilePhoto" name="profilePhoto" accept="image/png, image/jpeg, image/webp" form="profile-form" hidden>
        <p class="photo-hint">JPG, PNG or WEBP, up to 2 MB</p>
      </section>

      <div class="edit-column">

        <!-- Personal details -->
        <section class="edit-card">
          <h2 class="card-title">Personal details</h2>
          <form action="/user/profile/edit" method="POST" enctype="multipart/form-data" id="profile-form" class="edit-form">
            <div class="field">
              <label for="name">Full name</label>
              <input type="text" id="name" name="name" value="<%= user.name %>" required>
            </div>

            <div class="field">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" value="<%= user.email %>" required>
            </div>

            <div class="field">
              <label for="contact">Contact number</label>
              <div class="contact-input">
                <span class="contact-prefix">+91</span>
                <input type="tel" id="contact" name="contact" value="<%= user.contact %>" pattern="[0-9]{10}" maxlength="10" inputmode="numeric" title="Enter a 10 digit mobile number" required>
              </div>
            </div>

            <div class="form-actions">
              <a href="/amazon-clone/profile" class="btn btn-ghost">Cancel</a>
              <button type="submit" class="btn btn-primary">Save changes</button>
            </div>
          </form>
        </section>

        <!-- Change password -->
        <section class="edit-card">
          <h2 class="card-title">Change password</h2>
          <form action="/user/profile/password" method="POST" class="edit-form">
            <div class="field">
              <label for="currentPassword">Current password</label>
              <input type="password" id="currentPassword" name="currentPassword" autocomplete="current-password" required>
            </div>

            <div class="field-row">
              <div class="field">
                <label for="newPassword">New password</label>
                <input type="password" id="newPassword" name="newPassword" minlength="6" autocomplete="new-password" required>
              </div>
              <div class="field">
                <label for="confirmPassword">Confirm new password</label>
                <input type="password" id="confirmPassword" name="confirmPassword" minlength="6" autocomplete="new-password" required>
              </div>
            </div>
            <p class="field-hint">Use at least 6 characters.</p>

            <div class="form-actions">
              <button type="submit" class="btn btn-primary">Update password</button>
            </div>
          </form>
        </section>

        <!-- Addresses -->
        <a href="/amazon-clone/addresses" class="edit-card link-card">
          <div class="link-text">
            <span class="link-title">Change address</span>
            <span class="link-sub">
              <% if (user.addresses && user.addresses.length) { %>
                <%= user.addresses[0].street %>, <%= user.addresses[0].city %>, <%= user.addresses[0].state %> - <%= user.addresses[0].postalCode %>
              <% } else { %>
                No address added yet
              <% } %>
            </span>
          </div>
          <span class="link-arrow">›</span>
        </a>

      </div>
    </div>
  </main>

  <script src="/js/toast.js"></script>
  <script>
    // live preview of the chosen photo before saving
    document.getElementById('profilePhoto').addEventListener('change', e => {
      const file = e.target.files[0];
      if (!file) return;
      const img = document.getElementById('photo-img');
      const initial = document.getElementById('photo-initial');
      img.src = URL.createObjectURL(file);
      img.hidden = false;
      if (initial) initial.hidden = true;
    });
  </script>
</body>
</html>
