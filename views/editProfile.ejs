<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Profile - Node</title>
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Pacifico&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/editProfile.css">
  <link rel="stylesheet" href="/css/toast.css">
</head>
<body>

  <header class="topbar">
    <div class="topbar-inner">
      <a href="/amazon-clone" class="logo">Node</a>
    </div>
  </header>

  <main class="edit-page">
    <div class="page-head">
      <h1>Edit profile</h1>
      <a href="/amazon-clone/profile" class="back-link">← Back to profile</a>
    </div>

    <div class="edit-grid">

      <!-- Left: profile photo -->
      <section class="edit-card photo-card">
        <div class="photo-preview" id="photo-preview">
          <% if (user.profilePhoto) { %>
            <img src="<%= user.profilePhoto %>" alt="Profile photo" id="photo-img">
          <% } else { %>
            <span class="photo-initial" id="photo-initial"><%= user.name ? user.name.charAt(0).toUpperCase() : "U" %></span>
            <img src="" alt="Profile photo" id="photo-img" hidden>
          <% } %>
        </div>

        <h2 class="photo-name"><%= user.name %></h2>
        <p class="photo-email"><%= user.email %></p>

        <!-- the file input belongs to the details form below via form="profile-form" -->
        <label for="profilePhoto" class="photo-btn">Change photo</label>
        <input type="file" id="profilePhoto" name="profilePhoto" accept="image/png, image/jpeg, image/webp" form="profile-form" hidden>
        <p class="photo-hint">JPG, PNG or WEBP, up to 2 MB</p>
      </section>

      <div class="edit-column">

        <!-- Personal details (email has its own card below) -->
        <section class="edit-card">
          <h2 class="card-title">Personal details</h2>
          <form id="profile-form" class="edit-form">
            <div class="field">
              <label for="name">Full name</label>
              <input type="text" id="name" name="name" value="<%= user.name %>" required>
            </div>

            <div class="field">
              <label for="contact">Contact number</label>
              <div class="contact-input">
                <span class="contact-prefix">+91</span>
                <input type="tel" id="contact" name="contact" value="<%= user.contact %>" pattern="[0-9]{10}" maxlength="10" inputmode="numeric" title="Enter a 10 digit mobile number" required>
              </div>
            </div>

            <div class="form-actions">
              <a href="/amazon-clone/profile" class="btn btn-ghost">Cancel</a>
              <button type="submit" class="btn btn-primary">Save changes</button>
            </div>
          </form>
        </section>

        <!-- Email: changing it needs a code to the current email, then one to the new email -->
        <section class="edit-card">
          <h2 class="card-title">Email</h2>

          <!-- state 1: current email + Change button -->
          <div class="email-row" id="email-row">
            <span class="email-current" id="email-current"><%= user.email %></span>
            <button type="button" class="btn btn-ghost" id="email-change-btn">Change</button>
          </div>

          <!-- state 2: type the new email -->
          <form id="email-start-form" class="edit-form" hidden>
            <div class="field">
              <label for="newEmail">New email</label>
              <input type="email" id="newEmail" name="newEmail" autocomplete="email" required>
            </div>
            <p class="field-hint">We'll send a code to your current email first, then one to the new email.</p>
            <div class="form-actions">
              <button type="button" class="btn btn-ghost email-cancel">Cancel</button>
              <button type="submit" class="btn btn-primary">Send code</button>
            </div>
          </form>

          <!-- state 3: type the 6-digit code (used for both codes) -->
          <form id="email-verify-form" class="edit-form" hidden>
            <p class="email-verify-hint" id="email-verify-hint">Enter the code we sent.</p>
            <div class="field">
              <label for="emailOtp">6-digit code</label>
              <input type="text" id="emailOtp" name="otp" class="otp-input" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" title="Enter the 6-digit code from your email" required>
            </div>
            <div class="form-actions">
              <button type="button" class="btn btn-ghost email-cancel">Cancel</button>
              <button type="submit" class="btn btn-primary">Verify</button>
            </div>
          </form>
        </section>

        <!-- Password: reuses the forgot-password OTP flow, sent to the current email -->
        <form action="/user/forgot-password" method="POST" class="password-link-form">
          <input type="hidden" name="email" value="<%= user.email %>">
          <button type="submit" class="edit-card link-card">
            <span class="link-text">
              <span class="link-title">Change password</span>
              <span class="link-sub">We'll email a code to <%= user.email %></span>
            </span>
            <span class="link-arrow">›</span>
          </button>
        </form>

        <!-- Addresses -->
        <a href="/amazon-clone/addresses" class="edit-card link-card">
          <div class="link-text">
            <span class="link-title">Change address</span>
            <span class="link-sub">
              <% if (user.addresses && user.addresses.length) { %>
                <%= user.addresses[0].street %>, <%= user.addresses[0].city %>, <%= user.addresses[0].state %> - <%= user.addresses[0].postalCode %>
              <% } else { %>
                No address added yet
              <% } %>
            </span>
          </div>
          <span class="link-arrow">›</span>
        </a>

      </div>
    </div>
  </main>

  <script src="/js/toast.js"></script>
  <script src="/js/editProfile.js"></script>
  <script>
    // live preview of the chosen photo before saving
    document.getElementById('profilePhoto').addEventListener('change', e => {
      const file = e.target.files[0];
      if (!file) return;
      const img = document.getElementById('photo-img');
      const initial = document.getElementById('photo-initial');
      img.src = URL.createObjectURL(file);
      img.hidden = false;
      if (initial) initial.hidden = true;
    });
  </script>
</body>
</html>
