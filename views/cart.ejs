<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your Cart - Node</title>
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Pacifico&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/cart.css">
</head>
<body>

  <header class="topbar">
    <div class="topbar-inner">
      <a href="/amazon-clone" class="logo">Node</a>
    </div>
  </header>

  <main class="cart-page">
    <h1>Your cart</h1>

    <% if (items.length === 0) { %>
      <div class="cart-empty">
        <p>Your cart is empty.</p>
        <a href="/amazon-clone" class="btn-primary">Browse products</a>
      </div>
    <% } else { %>
      <div class="cart-layout">

        <ul class="cart-list">
          <% items.forEach(item => { const l = item.listing; %>
            <li class="cart-item">
              <% if (l.product.images && l.product.images[0]) { %>
                <img src="<%= l.product.images[0] %>" alt="<%= l.product.name %>">
              <% } else { %>
                <div class="img-placeholder"></div>
              <% } %>

              <div class="cart-info">
                <h3><%= l.product.name %></h3>
                <p class="seller">Sold by <%= l.seller ? l.seller.storeName : 'Unknown seller' %></p>
                <p class="unit-price">₹<%= l.price.toLocaleString('en-IN') %> each</p>

                <div class="qty-row">
                  <div class="qty">
                    <button data-cart-action="dec" data-listing-id="<%= l._id %>" <%= item.quantity <= 1 ? 'disabled' : '' %> aria-label="Decrease quantity">−</button>
                    <span><%= item.quantity %></span>
                    <button data-cart-action="inc" data-listing-id="<%= l._id %>" <%= item.quantity >= l.stock ? 'disabled' : '' %> aria-label="Increase quantity">+</button>
                  </div>
                  <button class="remove-btn" data-cart-action="remove" data-listing-id="<%= l._id %>">Remove</button>
                </div>
                <% if (l.status !== 'active' || l.stock < 1) { %>
                  <p class="warn">This item is currently unavailable.</p>
                <% } %>
              </div>

              <div class="line-total">₹<%= (l.price * item.quantity).toLocaleString('en-IN') %></div>
            </li>
          <% }) %>
        </ul>

        <aside class="cart-summary">
          <h2>Order summary</h2>
          <div class="summary-row">
            <span>Items</span>
            <span><%= items.reduce((n, i) => n + i.quantity, 0) %></span>
          </div>
          <div class="summary-row total">
            <span>Total</span>
            <span>₹<%= total.toLocaleString('en-IN') %></span>
          </div>
          <a href="/amazon-clone/checkout" class="btn-primary">Proceed to checkout</a>
        </aside>

      </div>
    <% } %>
  </main>

  <script src="/js/cart.js"></script>
</body>
</html>
