<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up</title>
    <!-- <link rel="stylesheet" href="/signup.css"> -->
</head>
<body>

    <div class="signup-container">
        <h1>Create Account</h1>

        <% if (typeof error !== 'undefined' && error) { %>
            <p class="error-msg"><%= error %></p>
        <% } %>

        <form action="/user/createUser" method="POST">
            <label for="name">Full Name</label>
            <input type="text" id="name" name="name" placeholder="Enter your full name" required>

            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="Enter your email" required>

            <label for="password">Password</label>
            <input type="password" id="password" name="password" placeholder="Create a password" minlength="6" required>

            <label for="contact">Contact Number</label>
            <input type="tel" id="contact" name="contact" placeholder="10-digit mobile number" pattern="[0-9]{10}" minlength="10" maxlength="10" required>

            <button type="submit">Sign Up</button>
        </form>

        <p class="login-link">Already have an account? <a href="/login">Log in</a></p>
    </div>

</body>
</html>