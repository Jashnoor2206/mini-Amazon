<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your Addresses - Node</title>
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Pacifico&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/addressList.css">
  <link rel="stylesheet" href="/css/toast.css">
</head>
<body>

  <header class="topbar">
    <div class="topbar-inner">
      <a href="/amazon-clone" class="logo">Node</a>
    </div>
  </header>

  <main class="address-page">
    <div class="page-head">
      <h1>Your addresses</h1>
      <a href="/amazon-clone/profile" class="back-link">← Back to profile</a>
    </div>

    <div class="address-grid">

      <!-- add new address card -->
      <a href="/amazon-clone/enterAddress/<%= user._id %>?from=addresses" class="address-card add-card">
        <span class="add-icon">+</span>
        <span class="add-text">Add address</span>
      </a>

      <% addresses.forEach(a => { %>
        <article class="address-card">
          <div class="address-tags">
            <span class="address-label"><%= a.label %></span>
            <% if (a.isDefault) { %><span class="default-badge">Default</span><% } %>
          </div>
          <p class="address-name"><%= user.name %></p>
          <p><%= a.street %></p>
          <p><%= a.city %>, <%= a.state %> - <%= a.postalCode %></p>
          <p><%= a.country %></p>
          <p class="address-contact">Phone: <%= user.contact %></p>

          <div class="address-actions">
            <button type="button" class="remove-btn" data-address-id="<%= a._id %>">Remove</button>
          </div>
        </article>
      <% }) %>

    </div>

    <p class="empty-state" <%= addresses.length ? 'hidden' : '' %>>You haven't added any addresses yet.</p>
  </main>

  <dialog id="remove-dialog" class="confirm-dialog">
    <p class="confirm-text">Do you want to remove this address?</p>
    <div class="confirm-actions">
      <button type="button" id="remove-no" class="confirm-btn confirm-no">No</button>
      <button type="button" id="remove-yes" class="confirm-btn confirm-yes">Yes</button>
    </div>
  </dialog>

  <script src="/js/toast.js"></script>
  <script src="/js/addressList.js"></script>
</body>
</html>
